{
  "serial": {
    "port": "/dev/ttyUSB0",
    "baudrate": 115200,
    "timeout": 1.0,
    "auto_scroll": true,
    "logging_enabled": true,
    "terminal_max_width": 400
  },
  "esc": {
    "num_of_esc": 3,
    "frequency": "300Hz",
    "esc1": {
      "gpio": "GPIO9",
      "direction": "Inverted",
      "calibration": [
        1000,
        1460,
        1500,
        1535,
        2000
      ]
    },
    "esc2": {
      "gpio": "GPIO10",
      "direction": "Normal",
      "calibration": [
        1000,
        1465,
        1500,
        1545,
        2000
      ]
    },
    "esc3": {
      "gpio": "GPIO11",
      "direction": "Inverted",
      "calibration": [
        1000,
        1480,
        1500,
        1545,
        2000
      ]
    }
  },
  "light": {
    "gpio": "GPIO4",
    "frequency": "44100Hz",
    "control_method": "array",
    "gamma": "3.0",
    "power_values": [
      0,
      2,
      3,
      4,
      5,
      6,
      256
    ]
  },
  "control_pad": {
    "forward": [
      0.35,
      0.35,
      0.15
    ],
    "backward": [
      -0.2,
      -0.15,
      -0.15
    ],
    "rotate_left": [
      0.0,
      0.3,
      -0.45
    ],
    "rotate_right": [
      0.0,
      -0.35,
      0.2
    ],
    "up": [
      -0.35,
      -0.15,
      0.2
    ],
    "down": [
      0.35,
      0.15,
      -0.2
    ],
    "roll_left": [
      0.0,
      0.0,
      0.0
    ],
    "roll_right": [
      0.0,
      0.0,
      0.0
    ],
    "stop": [
      0.0,
      0.0,
      0.0
    ]
  },
  "imu": {
    "graph_max_samples": 0,
    "graph_accel_y_limit": 16,
    "graph_gyro_y_limit": 200,
    "draw_graph_interval": 0.01,
    "graph_time_span_ms": 3000
  },
  "vc288": {
    "gpio": 12,
    "voltage_offset": 0.0,
    "current_offset": 0.0,
    "voltage_slope": 1.0,
    "current_slope": 1.0,
    "voltage_x2": 0.0,
    "current_x2": 0.0
  },
  "bno085": {
    "tx_gpio": "GPIO5",
    "rx_gpio": "GPIO4"
  },
  "mpu6050": {
    "sda_gpio": "GPIO37",
    "scl_gpio": "GPIO36"
  },
  "leakage": {
    "gpio": "GPIO2",
    "calibration_scans": 3
  }
}